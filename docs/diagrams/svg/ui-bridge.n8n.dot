digraph G {
  rankdir=TB;
  graph [splines=polyline, nodesep=0.35, ranksep=0.55, fontname="Helvetica"];
  node  [fontname="Helvetica", fontsize=11, margin="0.12,0.06"];
  edge  [fontname="Helvetica", fontsize=9];
  "hook" [label="Webhook — one per request endpoint", shape=box, style="rounded"];
  "route" [label="Switch — endpoint", shape=diamond];
  "exchats" [label="Execute Workflow — chats / memory", shape=box];
  "exlinks" [label="Execute Workflow — links / graph", shape=box];
  "exvoice" [label="Execute Workflow — voice resolve", shape=box];
  "exacts" [label="Execute Workflow — action confirm", shape=box];
  "excfg" [label="Execute Workflow — config", shape=box];
  "resp" [label="Respond to Webhook", shape=box, style="rounded"];
  "native" [label="Live event stream / token streaming stays NATIVE\nn8n: no SSE, no inter-node streaming", shape=cds];
  "hook" -> "route" [penwidth=2.2];
  "route" -> "exchats";
  "route" -> "exlinks";
  "route" -> "exvoice";
  "route" -> "exacts";
  "route" -> "excfg";
  "exchats" -> "resp" [penwidth=2.2];
  "exlinks" -> "resp" [penwidth=2.2];
  "exvoice" -> "resp" [penwidth=2.2];
  "exacts" -> "resp" [penwidth=2.2];
  "excfg" -> "resp" [penwidth=2.2];
  "native" -> "hook" [style=dashed];
}