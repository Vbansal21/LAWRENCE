digraph G {
  rankdir=TB;
  graph [splines=polyline, nodesep=0.35, ranksep=0.55, fontname="Helvetica"];
  node  [fontname="Helvetica", fontsize=11, margin="0.12,0.06"];
  edge  [fontname="Helvetica", fontsize=9];
  "trg" [label="Execute Workflow Trigger — payload + destination", shape=box, style="rounded"];
  "classify" [label="Code — classify personal vs shareable + secret scan", shape=box];
  "decide" [label="IF — external allowed", shape=diamond];
  "block" [label="NoOp — force local, deny external", shape=box];
  "redact" [label="Code — redact / sanitize", shape=box];
  "resp" [label="Respond — cleared payload", shape=box, style="rounded"];
  "note" [label="Downstream HTTP nodes call this FIRST\nn8n: gate is convention, not enforced", shape=cds];
  "trg" -> "classify" [penwidth=2.2];
  "classify" -> "decide" [penwidth=2.2];
  "decide" -> "block" [label="no"];
  "decide" -> "redact" [label="yes"];
  "redact" -> "resp" [penwidth=2.2];
  "note" -> "trg" [style=dashed];
}