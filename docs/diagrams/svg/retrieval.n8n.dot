digraph G {
  rankdir=TB;
  graph [splines=polyline, nodesep=0.35, ranksep=0.55, fontname="Helvetica"];
  node  [fontname="Helvetica", fontsize=11, margin="0.12,0.06"];
  edge  [fontname="Helvetica", fontsize=9];
  "trg" [label="Execute Workflow Trigger\nitems: need short_ctx long_ctx proactive deep", shape=box, style="rounded"];
  "knobs" [label="Set — knobs max_iter depth top_k fresh min_results categories\nn8n: no live env per call -> Workflow Static Data / Variables", shape=box];
  "iflong" [label="IF — long_ctx is empty", shape=diamond];
  "vrecall" [label="Vector Store notes — Get Many k=4\n+ Embeddings sub-node", shape=cylinder];
  "fmt" [label="Code — format_recall digest", shape=box];
  "discern" [label="Basic LLM Chain — DISCERN\nChat Model sub: local llama / Output Parser: RETRIEVAL_PLAN", shape=box];
  "clean" [label="Code — clean queries + enforce FR-003 fallback", shape=box];
  "rounds" [label="Loop Over Items — rounds max_iter\nn8n: conditional loop only via batch cap + early-exit IF, or Execute Workflow recursion", shape=box];
  "sw" [label="Switch — active categories\nn8n: arms are STATIC branches, not a dynamic pool", shape=diamond];
  "nGet" [label="Vector Store notes — Get Many per query", shape=cylinder];
  "nRank" [label="Code — merge by best rank -> candidates", shape=box];
  "dGet" [label="Vector Store docs — Get Many, filter file://", shape=cylinder];
  "dRank" [label="Code — dedup + MAX_PER_URL + BM25 rank", shape=box];
  "wGet" [label="Vector Store webcache — Get Many", shape=cylinder];
  "wUnder" [label="IF — hits under min_results", shape=diamond];
  "wSearch" [label="HTTP Request — web search", shape=box];
  "wFetch" [label="HTTP Request — fetch + read", shape=box];
  "wExtract" [label="Code — extract chunks", shape=box];
  "wUpsert" [label="Vector Store webcache — Insert, cache back", shape=cylinder];
  "wRank" [label="Code — dedup + BM25 rank", shape=box];
  "mrg" [label="Merge — combine arms\nn8n: branch recombination needs an explicit Merge", shape=box];
  "underq" [label="Code — which arms under min_results", shape=box];
  "ifunder" [label="IF — any arm under and assess enabled", shape=diamond];
  "assess" [label="Basic LLM Chain — ASSESS\nOutput Parser: RETRIEVAL_ASSESS", shape=box];
  "ifsuff" [label="IF — sufficient", shape=diamond];
  "fuse" [label="Code — RRF x BM25 fuse + top_k\nn8n: no native fusion node -> Code", shape=box];
  "resp" [label="Respond — GatherResult: understanding evidence queries iterations", shape=box, style="rounded"];
  "prog" [label="NoOp / HTTP notify — progress\nn8n: no token streaming between nodes", shape=cds];
  "trg" -> "knobs" [penwidth=2.2];
  "knobs" -> "iflong" [penwidth=2.2];
  "iflong" -> "vrecall" [label="true"];
  "vrecall" -> "fmt";
  "fmt" -> "discern";
  "iflong" -> "discern" [label="false"];
  "discern" -> "clean" [penwidth=2.2];
  "clean" -> "rounds" [penwidth=2.2];
  "rounds" -> "sw" [penwidth=2.2];
  "sw" -> "nGet" [label="notes"];
  "nGet" -> "nRank";
  "nRank" -> "mrg";
  "sw" -> "dGet" [label="doc"];
  "dGet" -> "dRank";
  "dRank" -> "mrg";
  "sw" -> "wGet" [label="web"];
  "wGet" -> "wUnder";
  "wUnder" -> "wSearch" [label="under"];
  "wSearch" -> "wFetch";
  "wFetch" -> "wExtract";
  "wExtract" -> "wUpsert";
  "wUpsert" -> "wRank";
  "wUnder" -> "wRank" [label="enough"];
  "wRank" -> "mrg";
  "mrg" -> "underq" [penwidth=2.2];
  "underq" -> "ifunder";
  "ifunder" -> "fuse" [label="no"];
  "ifunder" -> "assess" [label="yes"];
  "assess" -> "ifsuff";
  "ifsuff" -> "fuse" [label="sufficient"];
  "ifsuff" -> "rounds" [label="refine queries", style=dashed];
  "fuse" -> "resp" [penwidth=2.2];
  "mrg" -> "prog" [style=dashed];
}